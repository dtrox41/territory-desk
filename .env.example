# Copy variable names into an untracked environment file when runtime setup begins.
# Never place real passwords, tokens, connection strings, or private keys here.

# Non-secret runtime mode
APP_ENV=
DATA_MODE=
NOTIFICATION_MODE=
DYNAMICS_INTEGRATION_MODE=

# Future server-side configuration — leave blank in this committed example
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DATABASE_URL=
SMS_PROVIDER_API_KEY=
