# Copy variable names into an untracked environment file when runtime setup begins.
# Never place real passwords, tokens, connection strings, or private keys here.

# Non-secret server or build-pipeline modes
APP_ENV=
RELEASE_GATE=
DATA_MODE=
AUTH_MODE=
SMS_MODE=
EMAIL_MODE=
CALENDAR_MODE=
DYNAMICS_INTEGRATION_MODE=
DEMO_PERSONAS_ENABLED=
PERSISTENCE_MODE=

# Client-visible public metadata — these values are never security controls
VITE_PUBLIC_APP_ENV=
VITE_PUBLIC_BASE_PATH=
VITE_PUBLIC_BUILD_ID=
VITE_FICTIONAL_PROTOTYPE=

# Future server-side configuration — leave blank in this committed example
SESSION_SECRET=
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DATABASE_URL=
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
